{
  "manifest_version": 3,
  "name": "Doodler for Slowly",
  "version": "0.2.0",
  "description": "Draw, import SVG, photos and text, remix drawings and hand them to the Slowly drawing editor.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.slowly.app/*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.slowly.app/*"],
      "js": ["content/friends.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor/*"],
      "matches": ["https://web.slowly.app/*"]
    }
  ]
}
